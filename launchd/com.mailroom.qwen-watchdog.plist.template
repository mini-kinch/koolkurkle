<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: substitute __HOME__ with $HOME at install (launchd does not expand $HOME).
     One-pass watchdog. RunAtLoad is false. Nothing loads until an operator bootstraps this plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mailroom.qwen-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/MailArchive/scripts/qwen-mlx-watchdog.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__HOME__/MailArchive/logs/qwen-watchdog.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/MailArchive/logs/qwen-watchdog.launchd.log</string>
</dict>
</plist>
