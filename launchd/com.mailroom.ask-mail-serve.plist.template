<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mailroom.ask-mail-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MAILARCHIVE_HOME__/.venv/bin/python</string>
    <string>__MAILARCHIVE_HOME__/scripts/ask_mail.py</string>
    <string>--serve</string>
    <string>--db</string>
    <string>__MAILARCHIVE_HOME__/mailroom.sqlite</string>
    <string>--fts-only</string>
    <string>--no-generate</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8743</string>
  </array>
  <key>WorkingDirectory</key><string>__MAILARCHIVE_HOME__/scripts</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__MAILARCHIVE_HOME__/logs/ask_mail_serve.log</string>
  <key>StandardErrorPath</key><string>__MAILARCHIVE_HOME__/logs/ask_mail_serve.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
