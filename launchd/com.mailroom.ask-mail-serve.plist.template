<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: substitute __HOME__ with $HOME at install (launchd does not expand $HOME).
     ask_mail serve, FTS only, no generate, on 127.0.0.1:8743.
     Nothing loads until an operator bootstraps this plist. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mailroom.ask-mail-serve</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/MailArchive/.venv/bin/python</string>
		<string>__HOME__/MailArchive/scripts/ask_mail.py</string>
		<string>--serve</string>
		<string>--db</string>
		<string>__HOME__/MailArchive/mailroom.sqlite</string>
		<string>--fts-only</string>
		<string>--no-generate</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8743</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/MailArchive/scripts</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/MailArchive/logs/ask_mail_serve.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/MailArchive/logs/ask_mail_serve.log</string>
</dict>
</plist>
